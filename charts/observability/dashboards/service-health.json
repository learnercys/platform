{
  "uid": "service-health",
  "title": "Service health",
  "description": "RED metrics, LLM usage and traces",
  "tags": [
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "event-pipeline,ledger,llm-gateway",
        "allValue": "event-pipeline|ledger|llm-gateway",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Requests (RED)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[2m])) or sum by (service_name) (rate(rpc_server_call_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[2m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx, Internal, Unavailable)",
      "description": "4xx, denied and not-found are correct answers and not counted",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.05,
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$namespace\",http_response_status_code=~\"5..\"}[5m])) or sum by (service_name) (rate(rpc_server_call_duration_seconds_count{k8s_namespace_name=~\"$namespace\",rpc_response_status_code=~\"INTERNAL|UNAVAILABLE|UNKNOWN|DEADLINE_EXCEEDED|DATA_LOSS\"}[5m]))) / (sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[2m])) or sum by (service_name) (rate(rpc_server_call_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[2m])))) or vector(0)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=~\"$namespace\"}[5m]))) or histogram_quantile(0.95, sum by (le, service_name) (rate(rpc_server_call_duration_seconds_bucket{k8s_namespace_name=~\"$namespace\"}[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Ledger RPCs by method and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "rpc_method": "method",
              "rpc_response_status_code": "status",
              "Value": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (rpc_method, rpc_response_status_code) (increase(rpc_server_call_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[$__range])))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "HTTP responses by service, route and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "service",
              "http_route": "route",
              "http_response_status_code": "status",
              "Value": "requests"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (service_name, http_route, http_response_status_code) (increase(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$namespace\"}[$__range])))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Database query p95 by service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(db_client_operation_duration_seconds_bucket{k8s_namespace_name=~\"$namespace\"}[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "LLM gateway",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens / s by model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_response_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m]))",
          "legendFormat": "{{gen_ai_response_model}} {{gen_ai_token_type}}"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Model call p95 by model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Failed model calls / s by provider",
      "description": "Failures trigger the fallback chain; a steady rate here means a provider is degraded",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_provider_name, error_type) (rate(gen_ai_client_operation_duration_seconds_count{error_type!=\"\"}[5m]))",
          "legendFormat": "{{gen_ai_provider_name}} {{error_type}}"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Spend by tenant and model (selected range)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "tenant_id": "tenant",
              "gen_ai_response_model": "model",
              "Value": "USD"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (tenant_id, gen_ai_response_model) (increase(gateway_cost_USD_total[$__range])))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Full event journeys: ingest \u2192 relay \u2192 both consumers",
      "description": "One payment event, followed across the outbox, SNS and SQS. Click a trace to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"ingest\"} >> {resource.service.name=\"ledger-consumer\"} && {resource.service.name=\"ingest\"} >> {resource.service.name=\"analytics-consumer\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Slowest requests",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{kind=server && resource.service.namespace=~\"$namespace\"} | select(span.http.route, span.rpc.method)",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Model calls",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.gen_ai.request.model != nil} | select(span.gen_ai.response.model, span.gen_ai.usage.input_tokens, span.gen_ai.usage.output_tokens)",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 17,
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 9
      }
    }
  ]
}
